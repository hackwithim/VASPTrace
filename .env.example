# ==============================================
# VASPTrace Environment Configuration
# ==============================================

# Application
APP_NAME=VASPTrace
APP_ENV=development
DEBUG=true
API_PORT=8000
WEB_PORT=3000

# Authentication & Security
JWT_SECRET=super-secret-investigator-key-change-in-production-2026-sih
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Databases
# PostgreSQL (Default production/docker, will fallback to sqlite:///./vasptrace.db if unreachable in dev)
DATABASE_URL=postgresql://vasptrace:vasptrace_secure_pass@localhost:5432/vasptrace_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=vasptrace_graph_secret

# Redis Cache / Message Broker
REDIS_URL=redis://localhost:6379/0

# Blockchain API Providers
# Ethereum RPC & Explorers
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/demo
ETHEREUM_API_KEY=
ETHERSCAN_API_KEY=

# Bitcoin RPC & Explorers
BITCOIN_RPC_URL=https://blockstream.info/api
BITCOIN_API_KEY=

# Core Mode Configuration
# When MOCK_MODE=true, realistic demo blockchain data, VASP clusters, and attribution are used without requiring live RPC keys
MOCK_MODE=true

# SAHYOG Integration Adapter
SAHYOG_API_URL=https://sahyog.gov.in/api/v1/cases/submit-mock
SAHYOG_API_ENABLED=false
